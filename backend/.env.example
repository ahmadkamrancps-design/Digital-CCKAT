ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://cck:cck_local_only@localhost:5432/cck_digital_test
# Optional for candidates; needed for staff Google sign-in. Same as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
SESSION_COOKIE_NAME=cck_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
# Candidate sign-in request limits per 15-minute window. Tune IP limit for shared exam-center NAT.
CANDIDATE_LOGIN_ROLL_LIMIT=10
CANDIDATE_LOGIN_IP_LIMIT=1000
# Staff Google login requests per client IP per 15 minutes, including successful requests.
GOOGLE_LOGIN_IP_LIMIT=120
# Body limits: authentication is always 16 KiB; other JSON endpoints default to 2 MiB.
MAX_REQUEST_BYTES=2097152
LOG_LEVEL=INFO
# Production: use DATABASE_URL_FILE instead of DATABASE_URL; never set both.
# DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
REQUIRE_EXPIRY_WORKER=false
EXPIRY_WORKER_STALE_SECONDS=30
# Optional: a separate, disposable database for migration/integration tests.
# TEST_DATABASE_URL=postgresql+psycopg://cck:cck_local_only@localhost:5432/cck_digital_test_test
